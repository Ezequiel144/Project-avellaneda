---
import Key from "./Key.astro";

const { keys } = Astro.props as { keys: string[] };

//console.log(keys);
---

<div class="rounded-xl p-5 bg-[#A3A3A3]/10 flex flex-col gap-y-5 w-full">
  <h2 class="text-3xl sm:text-4xl font-semibold">Encontraras</h2>
  <ul class="flex gap-2 flex-wrap">
    {
      keys.length !== 0 ? (
        keys?.map((item) => <Key title={item} />)
      ) : (
        <li>Nada de nada</li>
      )
    }

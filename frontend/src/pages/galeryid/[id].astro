---
import ItemsKeys from "../../components/GaleryId/ItemsKeys.astro";
import { ReactContentGalery } from "../../components/GaleryId/ReactBusinessGalery/ReactContentGalery";
import Ubication from "../../components/GaleryId/Ubication.astro";
import type { GaleryItem } from "../../interface/business";
import Layout from "../../layouts/Layout.astro";
import { strapiFetch } from "../../utils/fetch";

const { id } = Astro.params as { id: string };

const current = async () => {
  const res = await strapiFetch(
    `/galeries/${id}?populate[image][fields][0]=url&populate[direction]=*&populate[keys]=*`,
    {
      method: "GET",
    },
  );
  return res.data as GaleryItem;
};

const galery = await current();

const pageTitle = `${galery?.title} | Informes Avellaneda`;
const pageDescription = "";
const openGraphImage = galery?.image?.url;

//console.log(galery);
---

<Layout
  title={pageTitle}
  description={pageDescription || ""}
  ogImage={openGraphImage}
>
  <section class="size-full flex flex-col gap-y-9 h-fit">
    <article class="h-[400px] md:h-[590px] w-full relative">
      <img
        src={`${galery?.image?.url}`}
        alt="imagen-front"
        class="size-full object-cover -z-10"
        onerror="this.onerror=null; this.src='/image/no-image.png';"
      />
      <div
        class="absolute inset-0 bg-gradient-to-t from-black/90 to-transparent"
      >
      </div>
      <div
        class="z-10 absolute bottom-4 left-1/2 -translate-x-1/2 text-white flex flex-col gap-y-2 w-full max-w-[1200px] px-3 xl:px-0"
      >
        <span class="text-2xl">Galeria</span>
        <h1 class="text-3xl sm:text-4xl font-bold">
          {galery?.title}
        </h1>
      </div>
    </article>
    <article
      class="max-w-[1200px] mx-auto w-full flex flex-col gap-y-5 px-3 xl:px-0"
    >
      <div class="w-full flex gap-5 md:flex-row flex-col">
        <ItemsKeys keys={galery?.keys.map((item) => item.itemtag) || []} />
        <Ubication direction={galery?.direction} />
      </div>
      <div class="flex flex-col gap-y-5">
        <h2 class="text:3xl sm:text-4xl font-semibold">Locales</h2>
        <ReactContentGalery client:idle documentId={id} />
      </div>
    </article>
  </section>
</Layout>

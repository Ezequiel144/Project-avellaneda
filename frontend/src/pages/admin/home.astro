---
import type { BusinessItemCard } from "../../interface/business";
import LayoutLoging from "../../layouts/LayoutLoging.astro";
import { strapiFetchjwt } from "../../utils/fetchjwt";

const jwt = Astro.cookies.get("jwt")?.value;
let businesses = [];

try {
  const res = await strapiFetchjwt(
    "/businesses?fields[0]=title&fields[1]=shortdescription&populate[imagelogo][fields][0]=url&populate[tags][fields][0]=*&populate=galery&populate[category]=*",
    {
      method: "GET",
      headers: {
        Authorization: `Bearer ${jwt}`,
      },
    },
  );

  businesses = res.data;
} catch (error) {
  console.error("Error al obtener negocios:", error);
}
---

<LayoutLoging title="" description="">
  <div class="p-10 w-full">
    <h1 class="text-2xl font-bold text-blue-500">Bienvenido</h1>
    <section>
      <div class="mb-5 flex flex-wrap items-center justify-between gap-4">
        <h2 class="text-xl font-bold text-heading">Negocios</h2>
        <a
          href="/admin/newbusiness"
          class="rounded-lg bg-blue-600 px-4 py-2.5 font-semibold text-white transition hover:bg-blue-700"
        >
          + Cargar negocio
        </a>
      </div>
      <p>Cantidad de negocios: {businesses.length}</p>

      <div
        class="relative overflow-x-auto bg-neutral-primary-soft rounded-xl shadow-sm border border-gray-200"
      >
        <table class="w-full text-sm text-left rtl:text-right text-body">
          <thead
            class="text-sm text-body bg-blue-50 text-blue-700"
          >
            <tr>
              <th scope="col" class="px-6 py-3 font-medium"> Titulo </th>
              <th scope="col" class="px-6 py-3 font-medium"> Tags </th>
              <th scope="col" class="px-6 py-3 font-medium"> Categoria </th>
              <th scope="col" class="px-6 py-3 font-medium"> Imagen </th>
              <th scope="col" class="px-6 py-3 font-medium">
                <span class="sr-only">Edit</span>
              </th>
            </tr>
          </thead>
          <tbody>
            {
              businesses.map((business: BusinessItemCard) => (
                <tr class="bg-neutral-primary-soft">
                  <th
                    scope="row"
                    class="px-6 py-4 font-medium text-heading whitespace-nowrap"
                  >
                    {business.title}
                  </th>
                  <td class="px-6 py-4">
                    {" "}
                    {business.tags?.map((tag) => tag.itemtag).join(", ")}{" "}
                  </td>
                  <td class="px-6 py-4">
                    {" "}
                    {business.category?.map((cat) => cat.title).join(", ")}{" "}
                  </td>
                  <td class="px-6 py-4">
                    <img
                      src={business.imagelogo?.url}
                      alt={business.title}
                      class="size-16 object-cover"
                    />
                  </td>
                  <td class="px-6 py-4 text-right">
                    <a
                      href="#"
                      class="font-medium text-fg-brand hover:underline"
                    >
                      Edit
                    </a>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>
  </div>
</LayoutLoging>

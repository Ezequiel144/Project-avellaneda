---
import { ClientRouter } from "astro:transitions";
import Sidebarlayout from "../components/Admin/sidebarlayout.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  ogImage?: string; // Propiedad opcional para la imagen de Open Graph
}

const { title, description, ogImage } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/svg/favincon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <!-- libreria swipper(carruseles)-->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.css"
    />

    <script src="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.js"
    ></script>

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta property="og:url" content={Astro.url.href} />

    <title>{title}</title>
  </head>

  <body>
    <Sidebarlayout />
    <slot />
  </body>
  <ClientRouter />
  <style>
    html,
    body {
      margin: 0;
      width: 100%;
      height: 100vh;
      font-family: "Montserrat Variable", sans-serif;
      position: relative;
      display: flex;
      flex-direction: row;
    }
  </style>
</html>
